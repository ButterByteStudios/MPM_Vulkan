#version 450

#extension GL_ARB_shading_language_include: enable
#include "global.glsl"

layout(set = 0, std430, binding = BIND_H) readonly buffer BlockHistogramSSBO
{
	uint histogram[];
};

layout(set = 0, std430, binding = BIND_BO) readonly buffer BlockBinOffsetsSSBOIn
{
    uint binOffsets[];
};

layout(set = 2, std430, binding = BIND_BR) readonly buffer BinSSBOIn
{
	Bin binsIn[];
};

layout(set = 2, std430, binding = BIND_BW) writeonly buffer BinSSBOOut
{
	Bin binsOut[];
};

layout(local_size_x = BIN_SIZE, local_size_y = 1, local_size_z = 1) in;

void main()
{
	uint bIndex = gl_WorkGroupID.x;
	uint currentPIndex = gl_LocalInvocationID.x;

	if (currentPIndex >= binsIn[bIndex].particleCount)
	{
		return;
	}

	vec2 cellPos = binsIn[bIndex].position[currentPIndex];

	// Find block index from pos = (floor(cellpos + 0.5) - 2) / 4
	ivec2 blockCoords = ivec2(cellPos - 1.5) >> LOG2_G; // Divide by 4
	uint block = blockIndex(blockCoords.x, blockCoords.y);

	uint particleInBlock = binsIn[bIndex].particleInBlock[currentPIndex];
	uint nextPIndex = particleInBlock & BIN_MASK;
	uint nextBaseBin = binOffsets[block];
	uint binInBlock = particleInBlock >> LOG2_BIN_SIZE;
	uint nextBIndex = nextBaseBin + binInBlock;

	binsOut[nextBIndex].F[nextPIndex] = binsIn[bIndex].F[currentPIndex];
	binsOut[nextBIndex].position[nextPIndex] = cellPos;
	binsOut[nextBIndex].mass[nextPIndex] = binsIn[bIndex].mass[currentPIndex];
	binsOut[nextBIndex].hardening[nextPIndex] = binsIn[bIndex].hardening[currentPIndex];
	binsOut[nextBIndex].materialId[nextPIndex] = binsIn[bIndex].materialId[currentPIndex];;

	if (nextPIndex == 0)
	{
		// Use the total particles in the block and the current particle
		binsOut[nextBIndex].particleCount = min(histogram[block] - (binInBlock << LOG2_BIN_SIZE), BIN_SIZE);
	}
}