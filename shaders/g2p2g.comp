#version 450

#extension GL_EXT_shader_atomic_float: enable
#extension GL_ARB_shading_language_include: enable
#include "global.glsl"
#include "svd.glsl"

layout(set = 0, std430, binding = BIND_VR) readonly buffer GridVelocitySSBOIn
{
	vec2 vRGrid[];
};

layout(set = 0, std430, binding = BIND_VW) writeonly buffer GridVelocitySSBOOut
{
	vec2 vWGrid[];
};

layout(set = 0, std430, binding = BIND_M) writeonly buffer GridMassSSBOOut
{
	float mGrid[];
};

layout(set = 0, std430, binding = BIND_H) writeonly buffer BlockHistogramSSBOOut
{
	uint histogram[];
};

layout(set = 0, std430, binding = BIND_BC) readonly buffer BlockBinCountSSBOOut
{
	uint blockBinCount[];
};

layout(set = 0, std430, binding = BIND_BO) readonly buffer BlockBinOffsetsSSBOOut
{
    uint blockBinOffsets[];
};

layout(set = 0, std430, binding = BIND_BR) buffer BinSSBOInOut
{
	Bin bins[];
};

layout(set = 0, std430, binding = BIND_MAT) buffer MaterialsSSBOIn
{
	Material mats[];
};

float qw0(float x)
{
	float xp = 1.5 - x;
	return 0.5 * xp * xp;
}

float qw1(float x)
{
	float xp = x - 1.0;
	return 0.75 - xp * xp;
}

float qw2(float x)
{
	float xp = x - 0.5;
	return 0.5 * xp * xp;
}

#define G (4)
#define LOG2_G (2)
#define G_MASK (G - 1)
#define G2 (G * G)
#define GBlockDimensions (G + 2 + 2)
#define GBlock (GBlockDimensions * GBlockDimensions)

const uint mortonLUT[4] = {
    0x00, 0x10, 0x40, 0x50
};

uint gridSubblockBlockIndex(uint x, uint y)
{
	uint perserve = (x & 0x03) | ((y & 0x03) << 2);
    return mortonLUT[x >> 2] | (mortonLUT[y >> 2] << 1) | perserve;
}

int gridStepX(uint x)
{
    if ((x & 3u) != 3u) // If x is not on a subblock right edge, adding 1 shifts the index to the right
        return 1;

	uint q = x >> 2;
    return (int(mortonLUT[q + 1u]) - int(mortonLUT[q])) - 3;
}

int gridStepY(uint y)
{
    if ((y & 3u) != 3u) // If y is not on a subblock top edge, adding 4 shifts the index up
        return 4;

	uint q = y >> 2;
    return 2 * (int(mortonLUT[q + 1u]) - int(mortonLUT[q])) - 12;
}

mat2 neohookeanKirchoff(mat2 F, float k, float mu)
{
	float J = determinant(F);
	mat2 F_T = transpose(F);
	float lambda = k - (mu * 0.66666666666667); 
	mat2 cauchy = mu / J * (F * F_T - mat2(1.0)) + (lambda * log(J) / J) * mat2(1.0);	
	return cauchy * J;
}



void naccProject(
    inout mat2 Fe_trial,
    float k,
    float mu,
    float beta,
    float M,
    float xi,
    inout float alpha,
    out mat2 tau
)
{
    mat2 I = mat2(1.0f);

    // 1. Elastic trial state
    mat2 b = Fe_trial * transpose(Fe_trial);

    float J = determinant(Fe_trial);

    float trB = b[0][0] + b[1][1];

    mat2 devB = b - 0.5f * trB * I;

    float p = -0.5f * k * (J * J - 1.0f);

    mat2 s = (mu / J) * devB;

    float sNorm = sqrt(
        dot(s[0], s[0]) +
        dot(s[1], s[1])
    );

    float q = sqrt(2.0f) * sNorm;

    // 2. Initial yield surface
    float p0 = k * sinh(xi * max(-alpha, 0.0f));

    // 3. SVD of trial elastic deformation
    mat2 U, V;
    vec2 sigma;

    SVD_FullDecompose(Fe_trial, U, sigma, V);

    // 4. Case 1: Maximum pressure tip
    if (p > p0)
    {
        p = p0;

        float Je = sqrt(1.0f - 2.0f * p / k);

        alpha += log(J / Je);

        float stretch = sqrt(Je);

        Fe_trial = U * (stretch * I) * transpose(V);

        tau = -p * I;

        return;
    }

    // 5. Case 2: Minimum pressure tip
    if (p < -beta * p0)
    {
        p = -beta * p0;

        float Je = sqrt(1.0f - 2.0f * p / k);

        alpha += log(J / Je);

        float stretch = sqrt(Je);

        Fe_trial = U * (stretch * I) * transpose(V);

        tau = -p * I;

        return;
    }

    // 6. Yield test
    float yield =
        (1.0f + 2.0f * beta) * q * q
        + M * M * (p + beta * p0) * (p - p0);

    if (yield < 0.0001f)
    {
        tau = s - p * I;

        return;
    }

    // 7. Case 3: Shear projection

    // New shear magnitude
    float qNew = M * sqrt(
        -(p + beta * p0) * (p - p0)
        / (1.0f + 2.0f * beta)
    );

    // 8. Case 3: Hardening update
    if (p0 > 0.0001f &&
        p < p0 - 0.0001f &&
        p > -beta * p0 + 0.0001f)
    {
        float pc = 0.5f * (1.0f - beta) * p0;

        float dx = pc - p;
        float dy = -q;

        float len = sqrt(dx * dx + dy * dy);

        float Dp = dx / len;
        float Dq = dy / len;

        float A =
            M * M * Dp * Dp
            + (1.0f + 2.0f * beta) * Dq * Dq;

        float B =
            M * M * Dp
            * (2.0f * pc - p0 + beta * p0);

        float C =
            M * M
            * (pc + beta * p0)
            * (pc - p0);

        float discriminant = max(
            B * B - 4.0f * A * C,
            0.0f
        );

        float root = sqrt(discriminant);

        float l1 = (-B + root) / (2.0f * A);
        float l2 = (-B - root) / (2.0f * A);

        float p1 = pc + l1 * Dp;
        float p2 = pc + l2 * Dp;

        float px =
            ((p - pc) * (p1 - pc) > 0.0f)
            ? p1 : p2;

        float JeCross = sqrt(1.0f - 2.0f * px / k);

        if (JeCross > 0.0001f)
        {
            alpha += log(J / JeCross);
        }
    }

    // 9. Correct deviatoric stress
    mat2 sNew = mat2(0.0f);

    if (q > 0.000001f)
    {
        sNew = s * (qNew / q);
    }

    // 10. Reconstruct corrected elastic b
    // Volume and trace are preserved in Case 3.

    mat2 bNew =
        (J / mu) * sNew
        + 0.5f * trB * I;

    // 11. Reconstruct corrected Fe
    // bNew shares the trial principal directions U.

    mat2 bDiag = transpose(U) * bNew * U;

    float lambda0 = max(bDiag[0][0], 0.0f);
    float lambda1 = max(bDiag[1][1], 0.0f);

    mat2 SigmaNew = mat2(
        sqrt(lambda0), 0.0f,
        0.0f, sqrt(lambda1)
    );

    Fe_trial = U * SigmaNew * transpose(V);

    // 12. Corrected Kirchhoff stress
    tau = sNew - p * I;
}



layout(local_size_x = BIN_SIZE, local_size_y = 1, local_size_z = 1) in;

// Naming conventions
// Gridblock = the G*G blocks comprising the grid
// Particleblock = the G*G blocks used for the particle spatial hash. Spatially off by two gridcells from the gridblocks
// Subblock = one of the 4 blocks loaded into shared memory
// Local = things inside of a subblock
// Coords = vec2 of the coordinates. suffix determines of what
// Cell = a suffix denoting the prefix is in cellspace
// Index = a suffix denoting the prefix is a flattened index

shared vec2 shVRGrid[GBlock];
shared vec2 shVWGrid[GBlock];
shared float shMGrid[GBlock];

void main()
{
	float dx = ubo.dx;
	float invDx = ubo.invDx;
	float dt = ubo.dt;
	uint dimensions = ubo.dimensions;

	uint pIndex = gl_LocalInvocationID.x;
	ivec2 gridBlockCoords = ivec2(gl_WorkGroupID.xy);
	ivec2 gridBlockCellCoords = gridBlockCoords * G;

	uint block = blockIndex(gridBlockCoords.x, gridBlockCoords.y);
	uint binCount = blockBinCount[block];

	if (binCount == 0)
	{
		return;
	}
	uint baseBin = blockBinOffsets[block];

	// Subblock x/y represent the subblock offsets determined by the bin
	uint subblockIndex = pIndex >> 4; // pIndex / 16
	uint subblockCellX = (subblockIndex & 1) * G;
	uint subblockCellY = (subblockIndex >> 1) * G;
	uint localIndex = pIndex & 15u; // pIndex % 16

	uint gridSubblockCellIndex = lossyMorton(gridBlockCellCoords.x + subblockCellX, gridBlockCellCoords.y + subblockCellY) + localIndex;
	uint localSubblockIndex = pIndex;

	shVRGrid[localSubblockIndex] = vRGrid[gridSubblockCellIndex];
	shVWGrid[localSubblockIndex] = vec2(0);
	shMGrid[localSubblockIndex] = 0;

	barrier();
	
	for (uint binInBlock = 0; binInBlock < binCount; binInBlock++)
	{
		uint binIndex = baseBin + binInBlock;

		uint binParticleCount = bins[binIndex].particleCount;
		if (pIndex < binParticleCount)
		{
			vec2 cellPosition = bins[binIndex].position[pIndex];
			float mass = bins[binIndex].mass[pIndex];

			ivec2 coords = ivec2(cellPosition - 0.5);
			ivec2 coordsInBlock = coords - gridBlockCellCoords;
			
			vec2 d = coords - cellPosition;

			float dx0 = d.x;
			float dx1 = (1 + d.x);
			float dx2 = (2 + d.x);

			float dy0 = d.y;
			float dy1 = (1 + d.y);
			float dy2 = (2 + d.y);

			float uw0 = qw0(-d.x);
			float uw1 = qw1(-d.x);
			float uw2 = qw2(-d.x);

			float vw0 = qw0(-d.y);
			float vw1 = qw1(-d.y);
			float vw2 = qw2(-d.y);

			vec2 v00 = uw0 * vw0 * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 0, coordsInBlock.y + 0)];
			vec2 v10 = uw1 * vw0 * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 1, coordsInBlock.y + 0)];
			vec2 v20 = uw2 * vw0 * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 2, coordsInBlock.y + 0)];

			vec2 v01 = uw0 * vw1 * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 0, coordsInBlock.y + 1)];
			vec2 v11 = uw1 * vw1 * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 1, coordsInBlock.y + 1)];
			vec2 v21 = uw2 * vw1 * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 2, coordsInBlock.y + 1)];

			vec2 v02 = uw0 * vw2 * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 0, coordsInBlock.y + 2)];
			vec2 v12 = uw1 * vw2 * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 1, coordsInBlock.y + 2)];
			vec2 v22 = uw2 * vw2 * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 2, coordsInBlock.y + 2)];

			vec2 v = v00 + v10 + v20 + 
					v01 + v11 + v21 + 
					v02 + v12 + v22;

			mat2 B = mat2(0);
			B[0] = (v00 + v01 + v02) * dx0 +
			 	(v10 + v11 + v12) * dx1 + 
				(v20 + v21 + v22) * dx2;

			B[1] = dy0 * (v00 + v10 + v20) +
				dy1 * (v01 + v11 + v21) +
				dy2 * (v02 + v12 + v22);

			float inv_D = 4.0;
			mat2 C = B * inv_D;

			mat2 F = (mat2(1.0) + C * dt) * bins[binIndex].F[pIndex];

			// 2 outer node halos are off limits so particles stay in particle block territory
			cellPosition = clamp(cellPosition + dt * v, 2, dimensions - 2);

			bins[binIndex].position[pIndex] = cellPosition;

			coords = ivec2(cellPosition - 0.5);
			coordsInBlock = coords - gridBlockCellCoords;

			d = coords - cellPosition;

			dx0 = d.x;
			dx1 = (1 + d.x);
			dx2 = (2 + d.x);

			dy0 = d.y;
			dy1 = (1 + d.y);
			dy2 = (2 + d.y);
			
			uw0 = qw0(-d.x);
			uw1 = qw1(-d.x);
			uw2 = qw2(-d.x);

			vw0 = qw0(-d.y);
			vw1 = qw1(-d.y);
			vw2 = qw2(-d.y);

			float w00 = uw0 * vw0;
			float w10 = uw1 * vw0;
			float w20 = uw2 * vw0;

			float w01 = uw0 * vw1;
			float w11 = uw1 * vw1;
			float w21 = uw2 * vw1;

			float w02 = uw0 * vw2;
			float w12 = uw1 * vw2;
			float w22 = uw2 * vw2;

			uint materialId = bins[binIndex].materialId[pIndex];
			float rho = mats[materialId].rho;

			mat2 kirchoff;
			float alpha;
			
			switch (materialId) {
				case 0:
					kirchoff = neohookeanKirchoff(F, mats[materialId].k, mats[materialId].mu);
					break;
				case 1:
					naccProject(F, mats[materialId].k, mats[materialId].mu, 0, 0, 0, alpha, kirchoff);
					break;
			}

			bins[binIndex].F[pIndex] = F;

			float volume = mass / rho * invDx * invDx; // scale volume to cell units
			
			mat2 stress = dt * -volume * kirchoff * inv_D;
			mat2 affine = stress + mass * C;

			vec2 vm = v * mass;

			vec2 ax0 = affine[0] * dx0 + vm;
			vec2 ax1 = affine[0] * dx1 + vm;
			vec2 ax2 = affine[0] * dx2 + vm;

			vec2 ay0 = affine[1] * dy0;
			vec2 ay1 = affine[1] * dy1;
			vec2 ay2 = affine[1] * dy2;

			vec2 vm00 = w00 * (ax0 + ay0);
			vec2 vm10 = w10 * (ax1 + ay0);
			vec2 vm20 = w20 * (ax2 + ay0);	
			
			vec2 vm01 = w01 * (ax0 + ay1);
			vec2 vm11 = w11 * (ax1 + ay1);
			vec2 vm21 = w21 * (ax2 + ay1);	
			
			vec2 vm02 = w02 * (ax0 + ay2);
			vec2 vm12 = w12 * (ax1 + ay2);
			vec2 vm22 = w22 * (ax2 + ay2);

			uint i00 = gridSubblockBlockIndex(coordsInBlock.x, coordsInBlock.y);

			int sx0 = gridStepX(coordsInBlock.x);
			int sx1 = gridStepX(coordsInBlock.x + 1u);

			int sy0 = gridStepY(coordsInBlock.y);
			int sy1 = gridStepY(coordsInBlock.y + 1u);

			uint i10 = uint(int(i00) + sx0);
			uint i20 = uint(int(i10) + sx1);

			uint i01 = uint(int(i00) + sy0);
			uint i11 = uint(int(i10) + sy0);
			uint i21 = uint(int(i20) + sy0);

			uint i02 = uint(int(i01) + sy1);
			uint i12 = uint(int(i11) + sy1);
			uint i22 = uint(int(i21) + sy1);

			atomicAdd(shVWGrid[i00].x, vm00.x);
			atomicAdd(shVWGrid[i00].y, vm00.y);
			atomicAdd(shVWGrid[i10].x, vm10.x);
			atomicAdd(shVWGrid[i10].y, vm10.y);
			atomicAdd(shVWGrid[i20].x, vm20.x);
			atomicAdd(shVWGrid[i20].y, vm20.y);

			atomicAdd(shVWGrid[i01].x, vm01.x);
			atomicAdd(shVWGrid[i01].y, vm01.y);
			atomicAdd(shVWGrid[i11].x, vm11.x);
			atomicAdd(shVWGrid[i11].y, vm11.y);
			atomicAdd(shVWGrid[i21].x, vm21.x);
			atomicAdd(shVWGrid[i21].y, vm21.y);

			atomicAdd(shVWGrid[i02].x, vm02.x);
			atomicAdd(shVWGrid[i02].y, vm02.y);
			atomicAdd(shVWGrid[i12].x, vm12.x);
			atomicAdd(shVWGrid[i12].y, vm12.y);
			atomicAdd(shVWGrid[i22].x, vm22.x);
			atomicAdd(shVWGrid[i22].y, vm22.y);


			atomicAdd(shMGrid[i00], mass * w00);
			atomicAdd(shMGrid[i10], mass * w10);
			atomicAdd(shMGrid[i20], mass * w20);

			atomicAdd(shMGrid[i01], mass * w01);
			atomicAdd(shMGrid[i11], mass * w11);
			atomicAdd(shMGrid[i21], mass * w21);

			atomicAdd(shMGrid[i02], mass * w02);
			atomicAdd(shMGrid[i12], mass * w12);
			atomicAdd(shMGrid[i22], mass * w22);

			uvec2 blockCoords = uvec2(cellPosition - 1.5) >> LOG2_G;
			uint bIndex = atomicAdd(histogram[blockIndex(blockCoords.x, blockCoords.y)], 1);
			bins[binIndex].blockParticleIndex[pIndex] = bIndex;
		}
	}

	barrier();

	atomicAdd(vWGrid[gridSubblockCellIndex].x, shVWGrid[localSubblockIndex].x);
	atomicAdd(vWGrid[gridSubblockCellIndex].y, shVWGrid[localSubblockIndex].y);
	atomicAdd(mGrid[gridSubblockCellIndex], shMGrid[localSubblockIndex]);
}