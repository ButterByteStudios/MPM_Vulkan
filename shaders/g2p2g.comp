#version 450

#extension GL_EXT_shader_atomic_float: enable
#extension GL_ARB_shading_language_include: enable
#include "global.glsl"
#include "constitutiveModels.glsl"

layout(set = 0, std430, binding = BIND_VR) readonly buffer GridVelocitySSBOIn
{
	vec2 vRGrid[];
};

layout(set = 0, std430, binding = BIND_VW) writeonly buffer GridVelocitySSBOOut
{
	vec2 vWGrid[];
};

layout(set = 0, std430, binding = BIND_M) writeonly buffer GridMassSSBOOut
{
	float mGrid[];
};

layout(set = 0, std430, binding = BIND_H) writeonly buffer BlockHistogramSSBOOut
{
	uint histogram[];
};

layout(set = 0, std430, binding = BIND_BC) readonly buffer BlockBinCountSSBOOut
{
	uint blockBinCount[];
};

layout(set = 0, std430, binding = BIND_BO) readonly buffer BlockBinOffsetsSSBOOut
{
    uint blockBinOffsets[];
};

layout(set = 0, std430, binding = BIND_MAT) buffer MaterialsSSBOIn
{
	Material mats[];
};

layout(set = 0, std430, binding = BIND_GBF) writeonly buffer GridBlockFlagSSBOOut
{
	uint gridBlockFlag[];
};

layout(set = 0, std430, binding = BIND_PBF) writeonly buffer ParticleBlockFlagSSBOOut
{
	uint particleBlockFlag[];
};

layout(set = 2, std430, binding = BIND_BR) buffer BinSSBOInOut
{
	Bin bins[];
};

#define G2 (G * G)
#define GBlockDimensions (G + 2 + 2)
#define GBlock (GBlockDimensions * GBlockDimensions)

const uint mortonLUT[4] = {
    0x00, 0x10, 0x40, 0x50
};

uint gridSubblockBlockIndex(uint x, uint y)
{
	uint perserve = (x & 0x03) | ((y & 0x03) << 2);
    return mortonLUT[x >> 2] | (mortonLUT[y >> 2] << 1) | perserve;
}

int gridStepX(uint x)
{
    if ((x & 3u) != 3u) // If x is not on a subblock right edge, adding 1 shifts the index to the right
        return 1;

	uint q = x >> 2;
    return (int(mortonLUT[q + 1u]) - int(mortonLUT[q])) - 3;
}

int gridStepY(uint y)
{
    if ((y & 3u) != 3u) // If y is not on a subblock top edge, adding 4 shifts the index up
        return 4;

	uint q = y >> 2;
    return 2 * (int(mortonLUT[q + 1u]) - int(mortonLUT[q])) - 12;
}



layout(local_size_x = BIN_SIZE, local_size_y = 1, local_size_z = 1) in;

// Naming conventions
// Gridblock = the G*G blocks comprising the grid
// Particleblock = the G*G blocks used for the particle spatial hash. Spatially off by two gridcells from the gridblocks
// Subblock = one of the 4 blocks loaded into shared memory
// Local = things inside of a subblock
// Coords = vec2 of the coordinates. suffix determines of what
// Cell = a suffix denoting the prefix is in cellspace
// Index = a suffix denoting the prefix is a flattened index

shared vec2 shVRGrid[GBlock];
shared vec2 shVWGrid[GBlock];
shared float shMGrid[GBlock];

void main()
{
	float dx = pubo.dx;
	float invDx = pubo.invDx;
	float dt = pubo.dt;
	uint dimensions = pubo.dimensions;

	uint pIndex = gl_LocalInvocationID.x;
	ivec2 blockCoords = ivec2(gl_WorkGroupID.xy);
	ivec2 blockCellCoords = blockCoords << LOG2_G;

	uint particleBlock = particleBlockIndex(blockCoords.x, blockCoords.y);
	uint binCount = blockBinCount[particleBlock];

	if (binCount == 0)
	{
		return;
	}
	uint baseBin = blockBinOffsets[particleBlock];

	// Subblock x/y represent the subblock offsets determined by the bin
	uint subblockIndex = pIndex >> 4; // pIndex / 16
	uint subblockCellX = (subblockIndex & 1) << LOG2_G;
	uint subblockCellY = (subblockIndex >> 1) << LOG2_G;
	uint localIndex = pIndex & 15u; // pIndex % 16

	uint gridSubblockCellIndex = lossyMorton(blockCellCoords.x + subblockCellX, blockCellCoords.y + subblockCellY) + localIndex;
	uint localSubblockIndex = pIndex;

	shVRGrid[localSubblockIndex] = vRGrid[gridSubblockCellIndex];
	shVWGrid[localSubblockIndex] = vec2(0);
	shMGrid[localSubblockIndex] = 0;

	float invD = 4.0 * invDx * invDx;
	float dtInvD = dt * invD;

	barrier();
	
	for (uint binInBlock = 0; binInBlock < binCount; binInBlock++)
	{
		uint binIndex = baseBin + binInBlock;

		uint binParticleCount = bins[binIndex].particleCount;
		if (pIndex < binParticleCount)
		{
			vec2 cellPosition = bins[binIndex].position[pIndex];
			float mass = bins[binIndex].mass[pIndex];

			ivec2 coords = ivec2(cellPosition - 0.5);
			ivec2 coordsInBlock = coords - blockCellCoords;
			
			vec2 d = coords - cellPosition;

			float dx0 = d.x * dx;
			float dx1 = fma(d.x, dx, dx);
			float dx2 = fma(d.x, dx, dx + dx);

			float dy0 = d.y * dx;
			float dy1 = fma(d.y, dx, dx);
			float dy2 = fma(d.y, dx, dx + dx);

			vec3 wu = qw(d.x);
			vec3 wv = qw(d.y);

			mat3 w = outerProduct(wv, wu);

			vec2 v00 = w[0][0] * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 0, coordsInBlock.y + 0)];
			vec2 v10 = w[1][0] * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 1, coordsInBlock.y + 0)];
			vec2 v20 = w[2][0] * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 2, coordsInBlock.y + 0)];

			vec2 v01 = w[0][1] * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 0, coordsInBlock.y + 1)];
			vec2 v11 = w[1][1] * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 1, coordsInBlock.y + 1)];
			vec2 v21 = w[2][1] * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 2, coordsInBlock.y + 1)];

			vec2 v02 = w[0][2] * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 0, coordsInBlock.y + 2)];
			vec2 v12 = w[1][2] * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 1, coordsInBlock.y + 2)];
			vec2 v22 = w[2][2] * shVRGrid[gridSubblockBlockIndex(coordsInBlock.x + 2, coordsInBlock.y + 2)];

			vec2 v = v00 + v10 + v20 + 
					v01 + v11 + v21 + 
					v02 + v12 + v22;

			mat2 B = mat2(0);
			B[0] = (v00 + v01 + v02) * dx0 +
			 	(v10 + v11 + v12) * dx1 + 
				(v20 + v21 + v22) * dx2;

			B[1] = dy0 * (v00 + v10 + v20) +
				dy1 * (v01 + v11 + v21) +
				dy2 * (v02 + v12 + v22);

			mat2 F = (mat2(1.0) + B * dtInvD) * bins[binIndex].F[pIndex];

			// 2 outer node halos are off limits so particles stay in particle block territory
			cellPosition = clamp(cellPosition + dt * v * invDx, 3, dimensions - 3);

			bins[binIndex].position[pIndex] = cellPosition;

			uint materialId = bins[binIndex].materialId[pIndex];
			float rho = mats[materialId].params[I_RHO];

			mat2 kirchoff;
			float alpha;
			
			switch (mats[materialId].materialType) 
			{
				case NEO_HOOKEAN:
					kirchoff = neohookeanKirchoff(F, mats[materialId].params[I_LAMBDA], mats[materialId].params[I_MU]);
					break;
				case NACC:
					alpha = bins[binIndex].hardening[pIndex];
					naccProject(F, mats[materialId].params[I_K], mats[materialId].params[I_MU], mats[materialId].params[I_BETA], mats[materialId].params[I_M], mats[materialId].params[I_XI], alpha, kirchoff);
					bins[binIndex].hardening[pIndex] = alpha;
					break;
				case NADP:
// h_0 > h_3 >= 0
// h_1, h_2 >= 0
					alpha = bins[binIndex].hardening[pIndex];
					druckerPrager(F, mats[materialId].params[I_LAMBDA], mats[materialId].params[I_MU], mats[materialId].params[I_H0], mats[materialId].params[I_H1], mats[materialId].params[I_H2], mats[materialId].params[I_H3], alpha, kirchoff);
					bins[binIndex].hardening[pIndex] = alpha;
					break;
			}

			bins[binIndex].F[pIndex] = F;

			coords = ivec2(cellPosition - 0.5);
			coordsInBlock = coords - blockCellCoords;

			d = coords - cellPosition;

			dx0 = dx0 = d.x * dx;
			dx1 = dx1 = fma(d.x, dx, dx);
			dx2 = dx2 = fma(d.x, dx, dx + dx);

			dy0 = dy0 = d.y * dx;
			dy1 = dy1 = fma(d.y, dx, dx);
			dy2 = dy2 = fma(d.y, dx, dx + dx);
			
			wu = qw(d.x);
			wv = qw(d.y);

			w = outerProduct(wv, wu);

			float volume = mass / rho;
			
			mat2 affine = (mass * B - dt * volume * kirchoff) * invD;

			vec2 vm = v * mass;

			vec2 ax0 = affine[0] * dx0 + vm;
			vec2 ax1 = affine[0] * dx1 + vm;
			vec2 ax2 = affine[0] * dx2 + vm;

			vec2 ay0 = affine[1] * dy0;
			vec2 ay1 = affine[1] * dy1;
			vec2 ay2 = affine[1] * dy2;

			vec3 vm00 = w[0][0] * vec3((ax0 + ay0), mass);
			vec3 vm10 = w[1][0] * vec3((ax1 + ay0), mass);
			vec3 vm20 = w[2][0] * vec3((ax2 + ay0), mass);	
			
			vec3 vm01 = w[0][1] * vec3((ax0 + ay1), mass);
			vec3 vm11 = w[1][1] * vec3((ax1 + ay1), mass);
			vec3 vm21 = w[2][1] * vec3((ax2 + ay1), mass);	
			
			vec3 vm02 = w[0][2] * vec3((ax0 + ay2), mass);
			vec3 vm12 = w[1][2] * vec3((ax1 + ay2), mass);
			vec3 vm22 = w[2][2] * vec3((ax2 + ay2), mass);

			int sx0 = gridStepX(coordsInBlock.x);
			int sx1 = gridStepX(coordsInBlock.x + 1u);

			int sy0 = gridStepY(coordsInBlock.y);
			int sy1 = gridStepY(coordsInBlock.y + 1u);

			uint i00 = gridSubblockBlockIndex(coordsInBlock.x, coordsInBlock.y);

			uint i10 = uint(int(i00) + sx0);
			uint i20 = uint(int(i10) + sx1);

			uint i01 = uint(int(i00) + sy0);
			uint i11 = uint(int(i10) + sy0);
			uint i21 = uint(int(i20) + sy0);

			uint i02 = uint(int(i01) + sy1);
			uint i12 = uint(int(i11) + sy1);
			uint i22 = uint(int(i21) + sy1);

			atomicAdd(shVWGrid[i00].x, vm00.x);
			atomicAdd(shVWGrid[i00].y, vm00.y);
			atomicAdd(shVWGrid[i10].x, vm10.x);
			atomicAdd(shVWGrid[i10].y, vm10.y);
			atomicAdd(shVWGrid[i20].x, vm20.x);
			atomicAdd(shVWGrid[i20].y, vm20.y);

			atomicAdd(shVWGrid[i01].x, vm01.x);
			atomicAdd(shVWGrid[i01].y, vm01.y);
			atomicAdd(shVWGrid[i11].x, vm11.x);
			atomicAdd(shVWGrid[i11].y, vm11.y);
			atomicAdd(shVWGrid[i21].x, vm21.x);
			atomicAdd(shVWGrid[i21].y, vm21.y);

			atomicAdd(shVWGrid[i02].x, vm02.x);
			atomicAdd(shVWGrid[i02].y, vm02.y);
			atomicAdd(shVWGrid[i12].x, vm12.x);
			atomicAdd(shVWGrid[i12].y, vm12.y);
			atomicAdd(shVWGrid[i22].x, vm22.x);
			atomicAdd(shVWGrid[i22].y, vm22.y);


			atomicAdd(shMGrid[i00], vm00.z);
			atomicAdd(shMGrid[i10], vm10.z);
			atomicAdd(shMGrid[i20], vm20.z);

			atomicAdd(shMGrid[i01], vm01.z);
			atomicAdd(shMGrid[i11], vm11.z);
			atomicAdd(shMGrid[i21], vm21.z);

			atomicAdd(shMGrid[i02], vm02.z);
			atomicAdd(shMGrid[i12], vm12.z);
			atomicAdd(shMGrid[i22], vm22.z);

			uvec2 blockCoords = (coords - 1u) >> LOG2_G;
			uint particleInBlock = atomicAdd(histogram[particleBlockIndex(blockCoords.x, blockCoords.y)], 1);
			bins[binIndex].particleInBlock[pIndex] = particleInBlock;
		}
	}

	barrier();

	atomicAdd(vWGrid[gridSubblockCellIndex].x, shVWGrid[localSubblockIndex].x);
	atomicAdd(vWGrid[gridSubblockCellIndex].y, shVWGrid[localSubblockIndex].y);
	atomicAdd(mGrid[gridSubblockCellIndex], shMGrid[localSubblockIndex]);

	// Toggle flags
	if (pIndex == 0)
	{
		particleBlockFlag[particleBlock] = 1; // Only one workgroup gets dispatched per block, so can be not atomic
	}

	if (localIndex == 0)
	{
		// Grid blocks can overlap. The bottom left of the 4 used subblocks is the index of gridblockcoords
		atomicOr(gridBlockFlag[gridSubblockCellIndex >> 4], 1u);
	}
}