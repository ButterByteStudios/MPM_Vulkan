#version 450

#extension GL_ARB_shading_language_include: enable
#include "global.glsl"

layout(set = 0, std430, binding = BIND_BO) buffer BlockBinOffsetsSSBOInOut
{
    uint blockBinOffsets[];
};

layout(set = 0, std430, binding = BIND_GBF) buffer GridBlockFlagSSBOInOut
{
	uint gridBlockFlag[];
};

layout(set = 0, std430, binding = BIND_PBF) buffer ParticleBlockFlagSSBOInOut
{
	uint particleBlockFlag[];
};

layout(set = 0, std430, binding = BIND_SID) writeonly buffer ScatterIndirectOut
{
	uint scatterX;
	uint scatterY;
	uint scatterZ;

	uint vertexCount;
	uint instanceCount;
	uint firstVertex;
	uint firstInstance;

	uint particleX;
	uint particleY;
	uint particleZ;

	uint gridX;
	uint gridY;
	uint gridZ;
	
    uint totalBins;
};


#define W (128)
#define W2 (W * 2)
#define W2m1 (W2 - 1)

layout(local_size_x = W, local_size_y = 1, local_size_z = 1) in;

shared uvec3 shSum[W2];

// Exclusive prefix sum on 256 size blocks
void main()
{
	// Load the last valid value into the totals since the final flag wont be preserved in the exclusive prefix sum
	if (gl_GlobalInvocationID.x == pubo.particleBlocks - 1)
	{
		particleX = particleBlockFlag[pubo.particleBlocks - 1];
	}

	if (gl_GlobalInvocationID.x == pubo.gridBlocks - 1)
	{
		gridX = gridBlockFlag[pubo.gridBlocks - 1];
	}

	uint localId = gl_LocalInvocationID.x;
	uint block = gl_WorkGroupID.x;

	uint base = block * W2;

	shSum[2 * localId] = uvec3(blockBinOffsets[base + 2 * localId], gridBlockFlag[base + 2 * localId], particleBlockFlag[base + 2 * localId]);
	shSum[2 * localId + 1] = uvec3(blockBinOffsets[base + 2 * localId + 1], gridBlockFlag[base + 2 * localId + 1], particleBlockFlag[base + 2 * localId + 1]);

	barrier();

	// Upsweep
	for (uint offset = 1; offset < W2; offset <<= 1)
	{
		uint i = (localId + 1) * offset * 2 - 1;
		if (i < W2)
		{
			shSum[i] += shSum[i - offset];
		}
		barrier();
	}

	// Clear last
	uvec3 localSum;
	if (localId == 0)
	{
		localSum = shSum[W2m1];
		shSum[W2m1] = uvec3(0);
	}

	barrier();

	// Downsweep
	for (uint offset = W2 >> 1; offset > 0; offset >>= 1)
	{
		uint i = (localId + 1) * 2 * offset - 1;
		if (i < W2)
		{
			uvec3 temp = shSum[i - offset];
			shSum[i - offset] = shSum[i];
			shSum[i] += temp;
		}
		barrier();
	}

	blockBinOffsets[base + 2 * localId] = shSum[2 * localId].x;
	blockBinOffsets[base + 2 * localId + 1] = shSum[2 * localId + 1].x;

	gridBlockFlag[base + 2 * localId] = shSum[2 * localId].y;
	gridBlockFlag[base + 2 * localId + 1] = shSum[2 * localId + 1].y;

	particleBlockFlag[base + 2 * localId] = shSum[2 * localId].z;
	particleBlockFlag[base + 2 * localId + 1] = shSum[2 * localId + 1].z;

	if (localId == 0)
	{
		blockBinOffsets[base] = localSum.x;
		gridBlockFlag[base] = localSum.y;
		particleBlockFlag[base] = localSum.z;
	}
}