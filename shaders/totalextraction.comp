#version 450

#extension GL_ARB_shading_language_include: enable
#include "global.glsl"

layout(set = 0, std430, binding = BIND_BC) readonly buffer BlockBinCountSSBOOut
{
	uint blockBinCount[];
};

layout(set = 0, std430, binding = BIND_BO) readonly buffer BlockBinOffsetsSSBOOut
{
    uint blockBinOffsets[];
};

layout(set = 0, std430, binding = BIND_SID) writeonly buffer ScatterIndirectOut
{
	uint scatterX;
	uint scatterY;
	uint scatterZ;

	uint vertexCount;
	uint instanceCount;
	uint firstVertex;
	uint firstInstance;
};

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main()
{
	uint totalBins = blockBinOffsets[pubo.blocks - 1] + blockBinCount[pubo.blocks - 1];
    scatterX = totalBins;
	vertexCount = totalBins * BIN_SIZE;
}