#version 450

#extension GL_ARB_shading_language_include: enable
#include "global.glsl"

layout(set = 0, std430, binding = BIND_VR) writeonly buffer GridVelocitySSBOClear
{
	vec2 vClearGrid[];
};

layout(set = 0, std430, binding = BIND_VW) buffer GridVelocitySSBONormalize
{
	vec2 vGrid[];
};

layout(set = 0, std430, binding = BIND_M) buffer GridMassSSBOIn
{
	float mGrid[];
};

layout(set = 0, std430, binding = BIND_GBF) buffer GridBlockFlagSSBOInOut
{
	uint gridBlockFlag[];
};

layout(set = 0, std430, binding = BIND_PBF) buffer ParticleBlockFlagSSBOInOut
{
	uint particleBlockFlag[];
};

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

shared uint originX;
shared uint originY;

void main()
{
    uint activeBlock = gl_WorkGroupID.x;
	uint blockMorton = gridBlockFlag[activeBlock];
	uint cellIndex = (blockMorton << 4) + gl_LocalInvocationID.x;

	if (gl_LocalInvocationID.x == 0)
	{
		originX = compact1by1(blockMorton << 4);
		originY = compact1by1(blockMorton << 3);

		gridBlockFlag[activeBlock] = originX;
	}

	barrier();

	uint x = originX + (gl_LocalInvocationID.x & 0x03);
	uint y = originY + (gl_LocalInvocationID.x >> 2);

	vec2 v = vGrid[cellIndex];
	float m = mGrid[cellIndex];

	// Reset mass for next steps scatter
	mGrid[cellIndex] = 0;
	vClearGrid[cellIndex] = vec2(0); // vClear isnt getting fully cleared

	// 3 outer node halos are boundaries so particles stay in particle block territory
	bool left = x <= 4;
	bool right = x >= pubo.dimensions - 4;
	bool down = y <= 4;
	bool up = y >= pubo.dimensions - 4;

	vec2 acceleration = vec2(0, -9.81 * pubo.dt * pubo.invDx) + pubo.speed * pubo.dt;

	if (m == 0)
	{
		vGrid[cellIndex] = vec2(0);
		return;
	}

	if (right)
	{
		v.x = min(0, v.x);
		acceleration.x = min(0, acceleration.x);
	}

	if (left)
	{
		v.x = max(0, v.x);
		acceleration.x = max(0, acceleration.x);
	}

	if (up)
	{
		v.y = min(0, v.y);
		acceleration.y = min(0, acceleration.y);
	}

	if (down)
	{
		v.y = max(0, v.y);
		acceleration.y = max(0, acceleration.y);
	}

	// Put in pushconstants maybe
	float cflSpeed = 0.1 * pubo.invDt;

	// Convert momentum to velocity
	vGrid[cellIndex] = clamp((v / m) + acceleration, -cflSpeed, cflSpeed);
}