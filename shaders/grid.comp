#version 450

#extension GL_ARB_shading_language_include: enable
#include "global.glsl"

layout(set = 0, std430, binding = BIND_VR) writeonly buffer GridVelocitySSBOClear
{
	vec2 vClearGrid[];
};

layout(set = 0, std430, binding = BIND_VW) buffer GridVelocitySSBONormalize
{
	vec2 vGrid[];
};

layout(set = 0, std430, binding = BIND_M) buffer GridMassSSBOIn
{
	float mGrid[];
};

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

	if (x >= pubo.dimensions || y >= pubo.dimensions)
	{
		return;
	}
    
    uint i = partialMorton(x, y);

	vec2 v = vGrid[i];
	float m = mGrid[i];

	// Reset mass for next steps scatter
	mGrid[i] = 0;
	vClearGrid[i] = vec2(0);

	// 3 outer node halos are boundaries so particles stay in particle block territory
	bool left = x <= 4;
	bool right = x >= pubo.dimensions - 4;
	bool down = y <= 4;
	bool up = y >= pubo.dimensions - 4;

	vec2 acceleration = vec2(0, -9.81 * pubo.dt * pubo.invDx) + pubo.speed * pubo.dt;

	if (m == 0)
	{
		vGrid[i] = vec2(0);
		return;
	}

	if (right)
	{
		v.x = min(0, v.x);
		acceleration.x = min(0, acceleration.x);
	}

	if (left)
	{
		v.x = max(0, v.x);
		acceleration.x = max(0, acceleration.x);
	}

	if (up)
	{
		v.y = min(0, v.y);
		acceleration.y = min(0, acceleration.y);
	}

	if (down)
	{
		v.y = max(0, v.y);
		acceleration.y = max(0, acceleration.y);
	}

	// Put in pushconstants maybe
	float cflSpeed = 0.5 * pubo.invDt;

	// Convert momentum to velocity
	vGrid[i] = clamp((v / m) + acceleration, -cflSpeed, cflSpeed);
}