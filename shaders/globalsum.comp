#version 450

#extension GL_ARB_shading_language_include: enable
#include "global.glsl"

layout(set = 0, std430, binding = BIND_BO) buffer BlockBinOffsetsSSBOOut
{
    uint blockBinOffsets[];
};

layout(set = 0, std430, binding = BIND_GBF) buffer GridBlockFlagSSBOInOut
{
	uint gridBlockFlag[];
};

layout(set = 0, std430, binding = BIND_PBF) buffer ParticleBlockFlagSSBOInOut
{
	uint particleBlockFlag[];
};

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

shared uint binOffset;
shared uint gridOffset;
shared uint particleOffset;

void main()
{
	uint localId = gl_LocalInvocationID.x;
	uint globalId = gl_GlobalInvocationID.x;

	if (localId == 0)
	{
		binOffset = blockBinOffsets[globalId];
		blockBinOffsets[globalId] = 0;

		gridOffset = gridBlockFlag[globalId];
		gridBlockFlag[globalId] = 0;

		particleOffset = particleBlockFlag[globalId];
		particleBlockFlag[globalId] = 0;
	}

	barrier();

	blockBinOffsets[globalId] += binOffset;
	gridBlockFlag[globalId] += gridOffset;
	particleBlockFlag[globalId] += particleOffset;
}