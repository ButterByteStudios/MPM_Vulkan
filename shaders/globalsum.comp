#version 450

#extension GL_ARB_shading_language_include: enable
#include "global.glsl"

layout(set = 0, std430, binding = BIND_BO) buffer BlockBinOffsetsSSBOOut
{
    uint blockBinOffsets[];
};

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

shared uint offset;

void main()
{
	uint localId = gl_LocalInvocationID.x;
	uint globalId = gl_GlobalInvocationID.x;

	if (localId == 0)
	{
		offset = blockBinOffsets[globalId];
		blockBinOffsets[globalId] = 0;
	}

	barrier();

	blockBinOffsets[globalId] += offset;
}